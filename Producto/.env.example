# ============================================================
# Copia este archivo como .env y rellena los valores de Neon
# NUNCA subas .env a Git (ya está en .gitignore)
# ============================================================

# --- Opción A: Base de datos LOCAL con Docker (por defecto) ---
# No hace falta configurar nada, arranca con: docker-compose up

# --- Opción B: Neon (PostgreSQL gratuito en la nube) ----------
# 1. Ve a https://neon.tech y crea una cuenta gratuita
# 2. Crea un proyecto → copia la connection string
# 3. Reemplaza los valores de abajo con los de tu proyecto Neon

# MS-Gestion (fit_db)
DB_GESTION_URL=jdbc:postgresql://<host>.neon.tech/fit_db?sslmode=require
# MS-Users (users_db)
DB_USERS_URL=jdbc:postgresql://<host>.neon.tech/users_db?sslmode=require
# MS-Ventas (ventas_db)
DB_VENTAS_URL=jdbc:postgresql://<host>.neon.tech/ventas_db?sslmode=require

DATABASE_USERNAME=<tu-usuario-neon>
DATABASE_PASSWORD=<tu-password-neon>